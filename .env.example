# Facet — example application environment.
# Copy to .env for local development: cp .env.example .env
# Never commit a real .env; every value below is a placeholder.
#
# Resolution order, highest precedence first:
#   1. the process environment (what a deployment exports; also what
#      `npm run dev` injects for the Vite origin below)
#   2. .env.local  — optional, gitignored, machine-local overrides. Create it
#      only if you actually need one; an empty file has no meaning. It is NOT
#      read when APP_ENV=production, and it may not define APP_ENV itself, so
#      "is this production?" is never decided by an untracked local file.
#   3. .env        — this file, copied and filled in
#
# The test suite has its own file with its own keys: see .env.testing.example.
# FACET_TEST_* names are never readable from application configuration.

# --- Application ---------------------------------------------------------
APP_NAME=Facet

# local | production
APP_ENV=local

# Ignored (forced off) when APP_ENV=production.
APP_DEBUG=true

# Canonical public origin. Localhost is accepted only outside production.
APP_URL=http://localhost:8000
APP_LOCALE=en

# Optional in local development. When set, PHP emits Vite's HMR client and
# source entrypoints from this origin without probing whether the server is up.
# Never used when APP_ENV=production.
#
# You do not need to set this for everyday work: `npm run dev` starts PHP and
# Vite together and exports the correct origin to the PHP child itself. Set it
# here only when running PHP by hand against a separately started Vite.
# VITE_DEV_SERVER_ORIGIN=http://127.0.0.1:5173

# --- Secrets -------------------------------------------------------------
# Required. Has NO fallback: the application throws if it is unset or empty.
# Generate one locally, e.g.: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=

# --- Database (MariaDB) --------------------------------------------------
# Required only by code that actually touches the database. The public site is
# file-backed (see content/) and renders with all three of these unset.
#
# All three are treated as secrets: they have NO fallback, so a missing value
# throws instead of silently connecting somewhere unintended. The DSN must use
# the mysql driver and utf8mb4 — an absent charset is added, a different one is
# rejected.
#
# Example: mysql:host=127.0.0.1;port=3306;dbname=facet;charset=utf8mb4
DB_DSN=
DB_USERNAME=
DB_PASSWORD=
