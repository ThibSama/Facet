{
    "name": "facet/facet",
    "description": "Facet — server-rendered PHP portfolio foundation.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Facet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Facet\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "lint:php": "@php tools/php-syntax-lint.php",
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "build": "npm run build",
        "lint:js": "npm run lint",
        "quality": [
            "@php -r \"exit((int) !is_dir('vendor'));\"",
            "@lint:php",
            "@analyse",
            "@lint:js",
            "@build",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "quality": "Aggregate gate: static analysis, JS/TS lint, production Vite build, then unit tests — the build runs first so the manifest-backed skin isolation tests assert against real artefacts. Fails closed on any sub-gate."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
