# Dependencies
/vendor/
/node_modules/

# Build output
/public/build/
/public/hot
.vite/

# Environment (never track real secrets).
# .env, .env.local and .env.testing are real machine-local files; only the
# placeholder-only templates are tracked.
.env
.env.*
!.env.example
!.env.testing.example

# Tooling caches / reports
/.phpunit.cache/
/.phpunit.result.cache
/var/
/coverage/
*.log

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Playwright end-to-end run artefacts
/tests/E2E/.results/
/playwright-report/
