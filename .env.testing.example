# Facet — example test-suite environment.
# Copy to .env.testing for local integration testing: cp .env.testing.example .env.testing
# Never commit a real .env.testing; every value below is a placeholder.
#
# These keys are owned by the test suite alone. They are deliberately NOT the
# application's DB_* keys, and the application cannot read them: Facet\Config\Config
# drops every FACET_TEST_* name on the way in, even though tests/bootstrap.php has
# already loaded this file into $_ENV in the same process. The suite likewise never
# falls back to DB_*, so a run either reached the disposable schema named here or it
# reported itself blocked.
#
# Consumers:
#   - tests/bootstrap.php + tests/Support/TestDatabase.php  (PHPUnit "Database" suite)
#   - tests/E2E/support/environment.ts + tests/E2E/fixtures/seed.php  (Playwright)
#
# The schema is destroyed and re-seeded on every run. Point this at a disposable
# database and never at a development or production one.

# --- Test database (MariaDB) ---------------------------------------------
# Required. The DSN must name the `facet_test` schema: both the E2E harness and
# the seeder refuse to run against any other name.
#
# Example: mysql:host=127.0.0.1;port=3306;dbname=facet_test;charset=utf8mb4
FACET_TEST_DB_DSN=
FACET_TEST_DB_USER=
FACET_TEST_DB_PASSWORD=
